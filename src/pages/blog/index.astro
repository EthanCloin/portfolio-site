---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostMeta from "../../components/PostMeta.astro";
import { SITE } from "../../site";
import { getPosts, postPath } from "../../lib/posts";

const posts = await getPosts();
---

<BaseLayout title={SITE.blogTitle} description={SITE.description}>
  <h1>Writing</h1>
  <p class="lede">{SITE.description}</p>
  {posts.length === 0 ? (
    <p>Nothing published yet. Check back soon.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <h2><a href={postPath(post)}>{post.data.title}</a></h2>
          <PostMeta date={post.data.date} tags={[]} />
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
